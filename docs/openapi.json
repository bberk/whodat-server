{
  "components": {
    "schemas": {
      "AddLeagueRequest": {
        "additionalProperties": false,
        "description": "Add a league with admin credentials (or a public league without them).",
        "properties": {
          "espn_league_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Espn League Id",
            "type": "string"
          },
          "espn_s2": {
            "anyOf": [
              {
                "format": "password",
                "maxLength": 4096,
                "minLength": 1,
                "type": "string",
                "writeOnly": true
              },
              {
                "type": "null"
              }
            ],
            "title": "Espn S2"
          },
          "espn_swid": {
            "anyOf": [
              {
                "format": "password",
                "maxLength": 4096,
                "minLength": 1,
                "type": "string",
                "writeOnly": true
              },
              {
                "type": "null"
              }
            ],
            "title": "Espn Swid"
          },
          "season": {
            "anyOf": [
              {
                "maximum": 2100.0,
                "minimum": 2000.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Season"
          }
        },
        "required": [
          "espn_league_id"
        ],
        "title": "AddLeagueRequest",
        "type": "object"
      },
      "AddLeagueResponse": {
        "description": "Result of adding or joining a league.",
        "properties": {
          "league": {
            "$ref": "#/components/schemas/LeagueSummary"
          },
          "season": {
            "title": "Season",
            "type": "integer"
          },
          "weeks_synced": {
            "items": {
              "type": "integer"
            },
            "title": "Weeks Synced",
            "type": "array"
          }
        },
        "required": [
          "league",
          "season",
          "weeks_synced"
        ],
        "title": "AddLeagueResponse",
        "type": "object"
      },
      "AddSeasonRequest": {
        "additionalProperties": false,
        "description": "Add and sync one more season for an existing league.",
        "properties": {
          "season": {
            "maximum": 2100.0,
            "minimum": 2000.0,
            "title": "Season",
            "type": "integer"
          }
        },
        "required": [
          "season"
        ],
        "title": "AddSeasonRequest",
        "type": "object"
      },
      "AddSeasonResponse": {
        "description": "The season added to a league and the weeks the sync ingested.",
        "properties": {
          "league_id": {
            "title": "League Id",
            "type": "integer"
          },
          "season": {
            "title": "Season",
            "type": "integer"
          },
          "weeks_synced": {
            "items": {
              "type": "integer"
            },
            "title": "Weeks Synced",
            "type": "array"
          }
        },
        "required": [
          "league_id",
          "season",
          "weeks_synced"
        ],
        "title": "AddSeasonResponse",
        "type": "object"
      },
      "CupWeekResponse": {
        "description": "A season's cup week and the week range an admin may choose from.",
        "properties": {
          "cup_week": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cup Week"
          },
          "regular_season_length": {
            "title": "Regular Season Length",
            "type": "integer"
          },
          "season": {
            "title": "Season",
            "type": "integer"
          }
        },
        "required": [
          "season",
          "cup_week",
          "regular_season_length"
        ],
        "title": "CupWeekResponse",
        "type": "object"
      },
      "CupWeekUpdateRequest": {
        "additionalProperties": false,
        "description": "Set a season's cup week, or clear it with ``null``.\n\nThe field is required so a malformed body cannot silently clear an existing cup week; the upper\nbound depends on stored season metadata and is validated by the service.",
        "properties": {
          "cup_week": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cup Week"
          }
        },
        "required": [
          "cup_week"
        ],
        "title": "CupWeekUpdateRequest",
        "type": "object"
      },
      "DivisionStandings": {
        "description": "A division's rows in overall-rank order; each row keeps its overall league rank.",
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "standings": {
            "items": {
              "$ref": "#/components/schemas/StandingsRow"
            },
            "title": "Standings",
            "type": "array"
          }
        },
        "required": [
          "name",
          "standings"
        ],
        "title": "DivisionStandings",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LeagueSummary": {
