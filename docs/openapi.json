  "info": {
    "title": "Victory Points API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "description": "Verify credentials, set the session cookie, and return the public user.\n\nAn unknown email and a wrong password return the same 401 body, so the endpoint cannot be used\nto enumerate accounts.",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicUser"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "Clear the session cookie.\n\nLogout is idempotent: it succeeds even when the caller has no valid session, so a browser can\nalways discard a stale or tampered cookie.",
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/signup": {
      "post": {
        "description": "Create an account from a valid invite, set the session cookie, and return the public user.\n\nA member invite also creates its league membership in the same transaction, so the response\nincludes that league; an admin invite returns ``league: null`` and the account must complete\nonboarding. Unknown and expired invite codes share one 400 response so the endpoint does not\nhelp a caller distinguish which part failed. A taken email returns 409.",
        "operationId": "signup_api_v1_auth_signup_post",
