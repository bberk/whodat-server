# Copy to .env and fill in real values. Never commit .env or any real secret.
# Every variable the app reads must be documented here (AC-DX-05).

# --- Backend ---
# SQLAlchemy URL for a host-run backend. Leave it unset when using the Docker Compose stack:
# compose supplies the Postgres URL, and a value here overrides it, so the backend would use
# this URL inside the container (SQLite by default) and the postgres service would go unused.
# For a host-run backend, set it in the shell or here. SQLite is the app default; Postgres is:
#   postgresql+psycopg://app:app@localhost:5432/app
# DATABASE_URL=sqlite:///./dev.db

# Used to sign sessions/tokens. Generate a long random value for production.
SECRET_KEY=dev-insecure-change-me

# Key used to encrypt per-user league credentials at rest (AES-256-GCM). Base64-encoded
# 32 random bytes: generate with `openssl rand -base64 32`. There is no default key;
# leave empty only when running code paths that never handle league credentials.
LEAGUE_CREDENTIALS_KEY=

# Deployment label: local | test | production
ENV=local

# Comma-separated list of browser origins allowed to call the API. Include every origin the
# frontend is served from: http://localhost:5173 for `pnpm dev`, http://localhost:8080 for the
# Docker Compose frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Refresh rate limits (optional; the defaults are shown).
# League-wide refresh: one per league every five minutes and three per user per hour.
REFRESH_LEAGUE_INTERVAL_SECONDS=300
REFRESH_USER_LIMIT=3
REFRESH_USER_WINDOW_SECONDS=3600
# Admin per-season refresh: consecutive seasons are allowed; the per-user cap is separate.
SEASON_REFRESH_LEAGUE_INTERVAL_SECONDS=0
SEASON_REFRESH_USER_LIMIT=60
SEASON_REFRESH_USER_WINDOW_SECONDS=3600

# Active-week projection refresh. Off by default locally and in tests. When enabled, the API
# process runs an in-process APScheduler job every 15 minutes on Sundays 13:00-24:00 and Mondays
# 20:00-24:00 in PROJECTION_REFRESH_TIMEZONE; it refreshes only the active week's ESPN
# projections and closes out a just-finished week. PROJECTION_REFRESH_LEAGUES is a comma-separated
# list of provider external ids; empty means every stored league.
PROJECTION_REFRESH_ENABLED=false
PROJECTION_REFRESH_TIMEZONE=America/New_York
PROJECTION_REFRESH_LEAGUES=

# --- Agent Identity (scripts/agent-identity.sh; optional) ---
# AGENT_NAME=agent
# AGENT_EMAIL=agent@users.noreply.github.com
# GH_TOKEN=

# --- Frontend ---
# Base URL of the backend API used by the SPA.
VITE_API_BASE_URL=http://localhost:8000
