# Copy to deploy/.env on the production VM and replace every placeholder.
# deploy/.env is git-ignored; never commit a real value.
#
# Values are plain (no quotes, no trailing comments) because deploy/deploy.sh reads DOMAIN
# directly. See docs/DEPLOY_ORACLE.md for the full setup and the openssl commands.

# Public hostname Caddy requests a TLS certificate for. Its DNS A/AAAA record must point at the
# VM before the first deploy, otherwise certificate issuance and the health check fail.
DOMAIN=standings.example.com

# Signs session cookies (HMAC-SHA256). Generate: openssl rand -hex 32
SECRET_KEY=replace-with-openssl-rand-hex-32

# Encrypts stored ESPN league credentials (base64 of 32 random bytes).
# Generate: openssl rand -base64 32
LEAGUE_CREDENTIALS_KEY=replace-with-openssl-rand-base64-32

# --- Postgres ---
# The production database identity. These are not the local-dev app/app pair.
# POSTGRES_USER and POSTGRES_DB must be valid unquoted Postgres identifiers.
POSTGRES_USER=whodat
POSTGRES_DB=whodat

# Generate: openssl rand -hex 32
# Hex only: the backend DATABASE_URL is built from this value, so characters that need
# URL-encoding (@, :, /, %) would break it.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

# Exact browser origin, no trailing slash. Same origin serves the SPA and the API.
CORS_ORIGINS=https://standings.example.com

# Deployment label. Anything other than local/test makes the backend refuse the insecure
# default SECRET_KEY and marks cookies Secure.
ENV=production
