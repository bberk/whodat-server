[Unit]
Description=Update the whodat DuckDNS public IPv4 record
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=duckdns
Group=duckdns
EnvironmentFile=/etc/whodat/duckdns.env
ExecStart=/usr/local/libexec/whodat-duckdns-update
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
