# Copy to deploy/server/.env, replace every placeholder, and chmod 600 the copy.
# Never commit deploy/server/.env or share `docker compose config` output: it resolves secrets.

DOMAIN=your-subdomain.duckdns.org
DUCKDNS_TOKEN=replace-with-duckdns-token

# Generate SECRET_KEY with `openssl rand -hex 32`.
SECRET_KEY=replace-with-session-signing-key
# Generate LEAGUE_CREDENTIALS_KEY with `openssl rand -base64 32`; back it up securely.
LEAGUE_CREDENTIALS_KEY=replace-with-base64-encoded-32-byte-key

# Use a URL-safe random password, for example `openssl rand -hex 24`.
# Keep the user/database names unchanged after the Postgres volume is initialized.
POSTGRES_USER=replace-with-postgres-user
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_DB=replace-with-postgres-database

# Keep these references so the backend credentials always match the Postgres service.
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
CORS_ORIGINS=https://${DOMAIN}

# Optional refresh limits (defaults shown). League-wide refresh stays conservative; admin
# per-season refresh allows consecutive seasons with a separate per-user cap.
# REFRESH_LEAGUE_INTERVAL_SECONDS=300
# REFRESH_USER_LIMIT=3
# REFRESH_USER_WINDOW_SECONDS=3600
# SEASON_REFRESH_LEAGUE_INTERVAL_SECONDS=0
# SEASON_REFRESH_USER_LIMIT=60
# SEASON_REFRESH_USER_WINDOW_SECONDS=3600
ENV=production
