# Copy to deploy/server/.env, replace every placeholder, and chmod 600 the copy.
# Never commit deploy/server/.env or share `docker compose config` output: it resolves secrets.

DOMAIN=your-subdomain.duckdns.org
DUCKDNS_TOKEN=replace-with-duckdns-token

# Generate SECRET_KEY with `openssl rand -hex 32`.
SECRET_KEY=replace-with-session-signing-key
# Generate LEAGUE_CREDENTIALS_KEY with `openssl rand -base64 32`; back it up securely.
LEAGUE_CREDENTIALS_KEY=replace-with-base64-encoded-32-byte-key

# Use a URL-safe random password, for example `openssl rand -hex 24`.
# Keep the user/database names unchanged after the Postgres volume is initialized.
POSTGRES_USER=replace-with-postgres-user
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_DB=replace-with-postgres-database

# Keep these references so the backend credentials always match the Postgres service.
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
CORS_ORIGINS=https://${DOMAIN}

# Optional refresh limits. Production defaults to a 5-second cooldown per league for both the
# league-wide and admin per-season refresh; the per-user buckets are separate.
REFRESH_LEAGUE_INTERVAL_SECONDS=5
REFRESH_USER_LIMIT=3
REFRESH_USER_WINDOW_SECONDS=3600
SEASON_REFRESH_LEAGUE_INTERVAL_SECONDS=5
SEASON_REFRESH_USER_LIMIT=60
SEASON_REFRESH_USER_WINDOW_SECONDS=3600
ENV=production

# Grafana (LAN-only dashboards). Use a URL-safe random password, for example
# `openssl rand -hex 24`. Dashboards are provisioned from the files under
# deploy/server/monitoring/grafana/dashboards; an edit made in the UI is replaced when that file
# changes, so commit dashboard changes to the file instead.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-grafana-admin-password
# The server's reserved LAN address (see DEPLOY_SERVER.md §3.3). Grafana binds only this address,
# so the dashboard is reachable on the home network but never on a public interface.
# Never use 0.0.0.0 here: that listens on every interface. manage.sh rejects wildcard, public,
# IPv6, and hostname values before it starts the stack.
GRAFANA_BIND_ADDRESS=192.168.1.50
# Host port for the Grafana UI. Reachable at http://<GRAFANA_BIND_ADDRESS>:<port>.
GRAFANA_PORT=3000
